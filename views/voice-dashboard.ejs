<%- include('partials/header', { title: 'AI Voice Dashboard', activePage: 'voice' }) %>

<div class="container" style="padding-top: 1.5rem; padding-bottom: 3rem;">
  <!-- Header Banner -->
  <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white; padding: 2rem; border-radius: 1rem; margin-bottom: 2rem; box-shadow: 0 4px 20px rgba(49, 46, 129, 0.15);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="display: inline-block; background: rgba(255,255,255,0.15); padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">
          🎙️ ElevenLabs Conversational AI + Twilio Toll-Free
        </div>
        <h1 style="font-size: 2rem; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
          AI Voice Assistant & Toll-Free Call Center
        </h1>
        <p style="color: #c7d2fe; margin-top: 0.5rem; max-width: 600px; font-size: 0.95rem;">
          Incoming calls to your toll-free number are dynamically answered by the ElevenLabs voice agent with real-time worker lookup, job matching, availability management, and human hand-off.
        </p>
      </div>
      <div>
        <a href="/api/voice/calls" target="_blank" class="btn" style="background: white; color: #1e1b4b; font-weight: 700; border: none;">
          View Raw JSON API →
        </a>
      </div>
    </div>
  </div>

  <!-- Telephony & AI Integration Status Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <!-- Card 1: Twilio -->
    <div class="action-card" style="padding: 1.25rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
        <span style="font-weight: 700; color: #374151;">Twilio Toll-Free Number</span>
        <span class="badge <%= twilioConfigured ? 'badge-open' : 'badge-closed' %>" style="font-size: 0.75rem;">
          <%= twilioConfigured ? 'ACTIVE' : 'SETUP REQUIRED' %>
        </span>
      </div>
      <div style="font-size: 1.25rem; font-weight: 800; color: #111827; font-family: monospace;">
        <%= twilioNumber || 'Not configured in .env' %>
      </div>
      <p style="font-size: 0.8rem; color: #6b7280; margin-top: 0.5rem;">
        Incoming Webhook: <code style="background: #f3f4f6; padding: 0.1rem 0.3rem; border-radius: 0.25rem;">POST /api/voice/incoming</code>
      </p>
    </div>

    <!-- Card 2: ElevenLabs -->
    <div class="action-card" style="padding: 1.25rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
        <span style="font-weight: 700; color: #374151;">ElevenLabs Conversational AI</span>
        <span class="badge <%= elevenlabsConfigured ? 'badge-open' : 'badge-closed' %>" style="font-size: 0.75rem;">
          <%= elevenlabsConfigured ? 'CONNECTED' : 'KEY MISSING' %>
        </span>
      </div>
      <div style="font-size: 1.1rem; font-weight: 700; color: #111827;">
        Agent ID: <span style="font-family: monospace; font-size: 0.95rem;"><%= agentId ? agentId.slice(0, 10) + '...' : 'None' %></span>
      </div>
      <p style="font-size: 0.8rem; color: #6b7280; margin-top: 0.5rem;">
        Media Stream: <code style="background: #f3f4f6; padding: 0.1rem 0.3rem; border-radius: 0.25rem;">wss://api.elevenlabs.io/v1/convai/conversation</code>
      </p>
    </div>

    <!-- Card 3: Human Escalation -->
    <div class="action-card" style="padding: 1.25rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
        <span style="font-weight: 700; color: #374151;">Human Escalation Line</span>
        <span class="badge badge-open" style="font-size: 0.75rem;">ENABLED</span>
      </div>
      <div style="font-size: 1.25rem; font-weight: 800; color: #111827; font-family: monospace;">
        <%= humanTransferNumber %>
      </div>
      <p style="font-size: 0.8rem; color: #6b7280; margin-top: 0.5rem;">
        Auto-routes calls when requested or upon AI fallback
      </p>
    </div>
  </div>

  <!-- ngrok Tunnel Status Banner -->
  <% if (ngrokPublicUrl) { %>
  <div style="background: linear-gradient(135deg, #064e3b 0%, #065f46 100%); color: white; padding: 1.25rem 1.5rem; border-radius: 0.75rem; margin-bottom: 2rem; box-shadow: 0 4px 12px rgba(6,78,59,0.2);">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
      <span style="font-size: 1.35rem;">🔗</span>
      <span style="font-weight: 700; font-size: 1.05rem;">ngrok Tunnel Active</span>
      <span style="background: #10b981; color: white; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.6rem; border-radius: 9999px; letter-spacing: 0.05em;">LIVE</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0.75rem;">
      <div>
        <div style="font-size: 0.75rem; color: #a7f3d0; font-weight: 600; margin-bottom: 0.25rem;">PUBLIC URL</div>
        <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(0,0,0,0.2); padding: 0.5rem 0.75rem; border-radius: 0.5rem;">
          <code id="ngrok-public-url" style="font-size: 0.85rem; flex: 1; word-break: break-all;"><%= ngrokPublicUrl %></code>
          <button onclick="copyToClipboard('ngrok-public-url')" style="background: rgba(255,255,255,0.2); border: none; color: white; padding: 0.25rem 0.5rem; border-radius: 0.35rem; cursor: pointer; font-size: 0.75rem; white-space: nowrap;">Copy</button>
        </div>
      </div>
      <div>
        <div style="font-size: 0.75rem; color: #a7f3d0; font-weight: 600; margin-bottom: 0.25rem;">TWILIO INCOMING WEBHOOK → Paste in Twilio Console</div>
        <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(0,0,0,0.2); padding: 0.5rem 0.75rem; border-radius: 0.5rem;">
          <code id="webhook-incoming" style="font-size: 0.82rem; flex: 1; word-break: break-all;"><%= ngrokPublicUrl %>/api/voice/incoming</code>
          <button onclick="copyToClipboard('webhook-incoming')" style="background: rgba(255,255,255,0.2); border: none; color: white; padding: 0.25rem 0.5rem; border-radius: 0.35rem; cursor: pointer; font-size: 0.75rem; white-space: nowrap;">Copy</button>
        </div>
      </div>
      <div>
        <div style="font-size: 0.75rem; color: #a7f3d0; font-weight: 600; margin-bottom: 0.25rem;">TWILIO STATUS CALLBACK → Paste in Twilio Console</div>
        <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(0,0,0,0.2); padding: 0.5rem 0.75rem; border-radius: 0.5rem;">
          <code id="webhook-status" style="font-size: 0.82rem; flex: 1; word-break: break-all;"><%= ngrokPublicUrl %>/api/voice/status</code>
          <button onclick="copyToClipboard('webhook-status')" style="background: rgba(255,255,255,0.2); border: none; color: white; padding: 0.25rem 0.5rem; border-radius: 0.35rem; cursor: pointer; font-size: 0.75rem; white-space: nowrap;">Copy</button>
        </div>
      </div>
    </div>
  </div>
  <% } else if (!ngrokConfigured) { %>
  <div style="background: #fffbeb; border: 1px solid #fbbf24; padding: 1.25rem 1.5rem; border-radius: 0.75rem; margin-bottom: 2rem;">
    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
      <span style="font-size: 1.35rem; flex-shrink: 0;">🔌</span>
      <div>
        <div style="font-weight: 700; color: #92400e; margin-bottom: 0.35rem;">ngrok Tunnel Not Configured</div>
        <p style="color: #78350f; font-size: 0.88rem; margin: 0 0 0.75rem;">
          Twilio needs a public HTTPS URL to reach <code style="background: #fef3c7; padding: 0.1rem 0.3rem; border-radius: 0.25rem;">/api/voice/incoming</code>.
          Add your ngrok authtoken to enable an auto-starting tunnel.
        </p>
        <ol style="color: #78350f; font-size: 0.87rem; margin: 0; padding-left: 1.25rem; line-height: 1.75;">
          <li>Get your free token at <a href="https://dashboard.ngrok.com/get-started/your-authtoken" target="_blank" style="color: #d97706;">dashboard.ngrok.com</a></li>
          <li>Add to <code style="background: #fef3c7; padding: 0.1rem 0.3rem; border-radius: 0.25rem;">.env</code>: <code style="background: #fef3c7; padding: 0.1rem 0.3rem; border-radius: 0.25rem;">NGROK_AUTHTOKEN=your_token_here</code></li>
          <li>Restart the server — the tunnel starts automatically</li>
        </ol>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Real-Time Call KPIs -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2.5rem;">
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 1.25rem; border-radius: 0.75rem; text-align: center;">
      <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Total Inbound Calls</div>
      <div style="font-size: 2.25rem; font-weight: 800; color: #0f172a; margin-top: 0.25rem;"><%= stats.totalCalls %></div>
    </div>
    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 1.25rem; border-radius: 0.75rem; text-align: center;">
      <div style="font-size: 0.85rem; font-weight: 600; color: #166534; text-transform: uppercase;">AI Resolved Calls</div>
      <div style="font-size: 2.25rem; font-weight: 800; color: #15803d; margin-top: 0.25rem;"><%= stats.completedCalls %></div>
    </div>
    <div style="background: #fef2f2; border: 1px solid #fecaca; padding: 1.25rem; border-radius: 0.75rem; text-align: center;">
      <div style="font-size: 0.85rem; font-weight: 600; color: #991b1b; text-transform: uppercase;">Human Escalations</div>
      <div style="font-size: 2.25rem; font-weight: 800; color: #b91c1c; margin-top: 0.25rem;"><%= stats.escalatedCalls %></div>
    </div>
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 1.25rem; border-radius: 0.75rem; text-align: center;">
      <div style="font-size: 0.85rem; font-weight: 600; color: #1e40af; text-transform: uppercase;">Avg Duration</div>
      <div style="font-size: 2.25rem; font-weight: 800; color: #2563eb; margin-top: 0.25rem;"><%= stats.averageDurationSeconds %>s</div>
    </div>
  </div>

  <!-- Recent Calls Log Table -->
  <div class="action-card" style="padding: 1.5rem; margin-bottom: 2rem;">
    <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; color: #111827;">
      Recent Inbound Voice Calls
    </h2>

    <% if (!calls || calls.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem; color: #6b7280;">
        <div style="font-size: 3rem; margin-bottom: 0.5rem;">📞</div>
        <p style="font-weight: 600; font-size: 1.1rem; color: #374151;">No voice calls recorded yet</p>
        <p style="font-size: 0.9rem; max-width: 450px; margin: 0.5rem auto;">
          When someone calls your toll-free number, Twilio forwards the audio stream to ElevenLabs, and calls will appear here in real-time.
        </p>
      </div>
    <% } else { %>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid #e5e7eb; color: #4b5563;">
              <th style="padding: 0.75rem 0.5rem;">Time</th>
              <th style="padding: 0.75rem 0.5rem;">Caller</th>
              <th style="padding: 0.75rem 0.5rem;">Identified Role</th>
              <th style="padding: 0.75rem 0.5rem;">Duration</th>
              <th style="padding: 0.75rem 0.5rem;">Status</th>
              <th style="padding: 0.75rem 0.5rem;">Resolution</th>
              <th style="padding: 0.75rem 0.5rem;">Call SID</th>
            </tr>
          </thead>
          <tbody>
            <% calls.forEach(call => { %>
              <tr style="border-bottom: 1px solid #f3f4f6;">
                <td style="padding: 0.75rem 0.5rem; color: #6b7280; font-size: 0.85rem;">
                  <%= new Date(call.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                </td>
                <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: #111827;">
                  <%= call.caller_name || call.caller_phone %>
                </td>
                <td style="padding: 0.75rem 0.5rem;">
                  <span style="display: inline-block; padding: 0.15rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; background: <%= call.caller_role === 'worker' ? '#dcfce7' : call.caller_role === 'employer' ? '#dbeafe' : '#f3f4f6' %>; color: <%= call.caller_role === 'worker' ? '#15803d' : call.caller_role === 'employer' ? '#1e40af' : '#4b5563' %>;">
                    <%= call.caller_role %>
                  </span>
                </td>
                <td style="padding: 0.75rem 0.5rem; color: #4b5563;">
                  <%= call.duration_seconds > 0 ? call.duration_seconds + 's' : 'In call' %>
                </td>
                <td style="padding: 0.75rem 0.5rem;">
                  <span class="badge <%= call.status === 'completed' ? 'badge-open' : call.status === 'escalated' ? 'badge-closed' : 'badge-open' %>" style="font-size: 0.75rem;">
                    <%= call.status %>
                  </span>
                </td>
                <td style="padding: 0.75rem 0.5rem; font-size: 0.85rem;">
                  <% if (call.escalated_to_human) { %>
                    <span style="color: #b91c1c; font-weight: 600;">👨‍💼 Transferred to Human</span>
                  <% } else { %>
                    <span style="color: #15803d; font-weight: 600;">🤖 AI Resolved</span>
                  <% } %>
                </td>
                <td style="padding: 0.75rem 0.5rem; font-family: monospace; font-size: 0.75rem; color: #9ca3af;">
                  <%= call.call_sid.slice(0, 14) %>...
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- ElevenLabs Agent Tools Reference Box -->
  <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.5rem;">
    <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem;">
      🛠️ Configured Backend Tools for ElevenLabs Agent
    </h3>
    <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 1rem;">
      The ElevenLabs Conversational AI Agent can execute the following tools in real-time via webhook:
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.75rem; font-size: 0.85rem;">
      <div style="background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
        <code style="font-weight: 700; color: #4338ca;">lookup_caller</code>
        <p style="color: #64748b; margin: 0.25rem 0 0 0;">Identifies caller as Worker or Employer from DB records.</p>
      </div>
      <div style="background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
        <code style="font-weight: 700; color: #4338ca;">get_open_jobs</code>
        <p style="color: #64748b; margin: 0.25rem 0 0 0;">Searches daily-wage openings by trade skill and locality.</p>
      </div>
      <div style="background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
        <code style="font-weight: 700; color: #4338ca;">toggle_worker_availability</code>
        <p style="color: #64748b; margin: 0.25rem 0 0 0;">Sets worker's status to Available today or Busy.</p>
      </div>
      <div style="background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
        <code style="font-weight: 700; color: #4338ca;">check_job_application_status</code>
        <p style="color: #64748b; margin: 0.25rem 0 0 0;">Checks status of worker's applied jobs and hiring requests.</p>
      </div>
      <div style="background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
        <code style="font-weight: 700; color: #4338ca;">post_urgent_job</code>
        <p style="color: #64748b; margin: 0.25rem 0 0 0;">Allows an employer to post a new job opening over voice.</p>
      </div>
      <div style="background: white; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
        <code style="font-weight: 700; color: #4338ca;">request_human_escalation</code>
        <p style="color: #64748b; margin: 0.25rem 0 0 0;">Transfers caller to human support coordinator line.</p>
      </div>
    </div>
  </div>
</div>

<script>
function copyToClipboard(elementId) {
  const el = document.getElementById(elementId);
  if (!el) return;
  const text = el.textContent || el.innerText;
  navigator.clipboard.writeText(text.trim()).then(() => {
    const btn = el.nextElementSibling;
    if (btn) {
      const orig = btn.textContent;
      btn.textContent = 'Copied ✓';
      btn.style.background = 'rgba(52, 211, 153, 0.4)';
      setTimeout(() => {
        btn.textContent = orig;
        btn.style.background = 'rgba(255,255,255,0.2)';
      }, 2000);
    }
  }).catch(() => {
    // Fallback for older browsers
    const range = document.createRange();
    range.selectNode(el);
    window.getSelection().removeAllRanges();
    window.getSelection().addRange(range);
    document.execCommand('copy');
    window.getSelection().removeAllRanges();
  });
}
</script>

<%- include('partials/footer') %>
