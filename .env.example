# Server Configuration
PORT=3000

# Supabase REST API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase PostgreSQL Connection Pooler (Port 6543 - Recommended for Node.js)
# Obtain from: Supabase Dashboard > Project Settings > Database > Connection String > Transaction Mode (Port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres

# Twilio SMS + Voice (IVR) Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1800XXXXXXX

# Public URL Twilio uses to reach this server (ngrok URL in local testing)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Telephony provider adapter: twilio (implemented). exotel/plivo reserved for later.
TELEPHONY_PROVIDER=twilio

# IVR behaviour
# bridge = connect the worker live to the hiring agency
# notify = play confirmation, hang up, SMS/webhook the agency with caller ID
IVR_CONNECT_MODE=bridge
IVR_GATHER_TIMEOUT=8
IVR_MAX_RETRIES=2
IVR_DIAL_TIMEOUT=25
IVR_VOICE=Polly.Aditi
IVR_LANGUAGE=en-IN
IVR_OPERATOR_PHONE=+919999900000
IVR_FALLBACK_PHONE=+919999900000
IVR_DEFAULT_AGENCY_PHONE=+919999900000
IVR_AGENCY_WEBHOOK_URL=
# Set true only for local XML testing without Twilio signatures
IVR_SKIP_SIGNATURE=false

# Protects /api/admin/ivr/* (send header X-Admin-Key)
ADMIN_API_KEY=change-me-to-a-long-random-string
